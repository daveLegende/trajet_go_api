// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TypeUtilisateur {
  PASSAGER
  CONDUCTEUR
  LES_DEUX
  ADMIN
}

enum StatutVerification {
  NON_VERIFIE
  EN_ATTENTE
  VERIFIE
}

enum StatutCompte {
  ACTIF
  SUSPENDU
  SUPPRIME
}

enum StatutVerificationVehicule {
  NON_VERIFIE
  EN_ATTENTE
  VERIFIE
  REJETE
}

enum TypeReservation {
  INSTANT
  AVEC_APPROBATION
}

enum StatutTrajet {
  OUVERT
  COMPLET
  ANNULE
  TERMINE
}

enum StatutReservation {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  ANNULEE
}

enum StatutTransaction {
  EN_ATTENTE
  REUSSIE
  ECHEC
  REMBOURSEE
}

enum TypeTransaction {
  CREDIT
  DEBIT
  REMBOURSEMENT
  PAIEMENT_RESERVATION
}

enum TypeNotification {
  NOUVELLE_RESERVATION
  RESERVATION_ACCEPTEE
  RESERVATION_REFUSEE
  NOUVEAU_MESSAGE
  SYSTEME
}

enum MotifSignalement {
  COMPORTEMENT_INAPPROPRIE
  CONDUITE_DANGEREUSE
  RETARD_EXCESSIF
  AUTRE
}

enum StatutSignalement {
  EN_ATTENTE
  EN_COURS
  RESOLU
  REJETE
}

enum StatutAlerteSos {
  ACTIVE
  PRISE_EN_CHARGE
  RESOLUE
  FAUSSE_ALERTE
}

model User {
  id                        String             @id @default(uuid())
  nom                       String
  prenom                    String
  email                     String             @unique
  telephone                 String             @unique
  mot_de_passe_hash         String
  date_naissance            DateTime?
  photo_profil_url          String?
  type_utilisateur          TypeUtilisateur    @default(PASSAGER)
  statut_verification       StatutVerification @default(NON_VERIFIE)
  piece_identite_url        String?
  note_moyenne              Decimal            @default(0.0) @db.Decimal(3, 2)
  nombre_trajets            Int                @default(0)
  langue_preferee           String             @default("fr")
  statut_compte             StatutCompte       @default(ACTIF)
  date_creation             DateTime           @default(now())
  date_derniere_connexion   DateTime?
  date_derniere_deconnexion DateTime?
  fcm_token                 String?

  refresh_tokens               RefreshToken[]
  vehicules                    Vehicule[]
  trajets                      Trajet[]
  reservations                 Reservation[]
  portefeuille                 Portefeuille?
  avis_donnes                  Avis[]                    @relation("AvisAuteur")
  avis_recus                   Avis[]                    @relation("AvisCible")
  conversations_participations ConversationParticipant[]
  messages_envoyes             Message[]
  notifications                Notification[]
  signalements_emis            Signalement[]             @relation("SignalementAuteur")
  signalements_recus           Signalement[]             @relation("SignalementCible")
  alertes_sos                  AlerteSos[]

  @@map("utilisateurs")
}

model Vehicule {
  id                        String                     @id @default(uuid())
  proprietaire_id           String
  marque                    String
  modele                    String
  couleur                   String
  immatriculation           String                     @unique
  nombre_places             Int
  annee                     Int
  carte_grise_url           String?
  assurance_url             String?
  date_expiration_assurance DateTime?
  statut_verification       StatutVerificationVehicule @default(EN_ATTENTE)
  photos                    String[]                   @default([])
  date_creation             DateTime                   @default(now())
  date_mise_a_jour          DateTime                   @updatedAt

  proprietaire User     @relation(fields: [proprietaire_id], references: [id], onDelete: Cascade)
  trajets      Trajet[]

  @@index([proprietaire_id])
  @@map("vehicules")
}

model Trajet {
  id                 String          @id @default(uuid())
  conducteur_id      String
  vehicule_id        String
  ville_depart       String
  ville_arrivee      String
  latitude_depart    Float
  longitude_depart   Float
  latitude_arrivee   Float
  longitude_arrivee  Float
  date_depart        DateTime
  heure_depart       String
  places_disponibles Int
  prix_par_place     Decimal         @db.Decimal(10, 2)
  type_reservation   TypeReservation @default(INSTANT)
  statut             StatutTrajet    @default(OUVERT)
  recurrence         String?
  preferences        Json            @default("{}")
  description        String?
  date_creation      DateTime        @default(now())
  date_mise_a_jour   DateTime        @updatedAt

  conducteur    User           @relation(fields: [conducteur_id], references: [id], onDelete: Cascade)
  vehicule      Vehicule       @relation(fields: [vehicule_id], references: [id], onDelete: Cascade)
  point_arrets  PointArret[]
  reservations  Reservation[]
  avis          Avis[]
  conversations Conversation[]
  signalements  Signalement[]
  alertes_sos   AlerteSos[]

  @@index([conducteur_id])
  @@index([vehicule_id])
  @@index([ville_depart, ville_arrivee, date_depart])
  @@map("trajets")
}

model PointArret {
  id            String   @id @default(uuid())
  trajet_id     String
  nom           String
  latitude      Float
  longitude     Float
  ordre         Int
  date_creation DateTime @default(now())

  trajet Trajet @relation(fields: [trajet_id], references: [id], onDelete: Cascade)

  @@index([trajet_id, ordre])
  @@map("point_arrets")
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model OtpVerification {
  id         String   @id @default(uuid())
  cible      String
  code_hash  String
  expires_at DateTime
  verifie    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([cible])
  @@map("otp_verifications")
}

model Reservation {
  id               String            @id @default(uuid())
  trajet_id        String
  passager_id      String
  statut           StatutReservation @default(EN_ATTENTE)
  places_reservees Int               @default(1)
  montant_total    Decimal           @db.Decimal(10, 2)
  date_creation    DateTime          @default(now())
  date_mise_a_jour DateTime          @updatedAt

  trajet       Trajet        @relation(fields: [trajet_id], references: [id], onDelete: Cascade)
  passager     User          @relation(fields: [passager_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([trajet_id])
  @@index([passager_id])
  @@map("reservations")
}

model Portefeuille {
  id               String   @id @default(uuid())
  user_id          String   @unique
  solde            Decimal  @default(0.00) @db.Decimal(12, 2)
  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("portefeuilles")
}

model Transaction {
  id               String            @id @default(uuid())
  portefeuille_id  String
  reservation_id   String?
  type             TypeTransaction
  montant          Decimal           @db.Decimal(12, 2)
  statut           StatutTransaction @default(EN_ATTENTE)
  cle_idempotence  String            @unique
  description      String?
  date_creation    DateTime          @default(now())
  date_mise_a_jour DateTime          @updatedAt

  portefeuille Portefeuille @relation(fields: [portefeuille_id], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservation_id], references: [id], onDelete: SetNull)

  @@index([portefeuille_id])
  @@index([cle_idempotence])
  @@map("transactions")
}

model Avis {
  id            String   @id @default(uuid())
  auteur_id     String
  cible_id      String
  trajet_id     String
  note          Int
  commentaire   String?
  date_creation DateTime @default(now())

  auteur User   @relation("AvisAuteur", fields: [auteur_id], references: [id], onDelete: Cascade)
  cible  User   @relation("AvisCible", fields: [cible_id], references: [id], onDelete: Cascade)
  trajet Trajet @relation(fields: [trajet_id], references: [id], onDelete: Cascade)

  @@unique([auteur_id, cible_id, trajet_id])
  @@index([cible_id])
  @@index([trajet_id])
  @@map("avis")
}

model Conversation {
  id               String   @id @default(uuid())
  trajet_id        String?
  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt

  trajet       Trajet?                   @relation(fields: [trajet_id], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id              String   @id @default(uuid())
  conversation_id String
  user_id         String
  date_creation   DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@map("conversation_participants")
}

model Message {
  id              String    @id @default(uuid())
  conversation_id String
  expediteur_id   String
  contenu         String    @db.Text
  lu              Boolean   @default(false)
  date_lecture    DateTime?
  date_creation   DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  expediteur   User         @relation(fields: [expediteur_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([expediteur_id])
  @@map("messages")
}

model Notification {
  id            String           @id @default(uuid())
  user_id       String
  titre         String
  message       String           @db.Text
  type          TypeNotification
  lu            Boolean          @default(false)
  donnees_liees Json?
  date_creation DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model Signalement {
  id               String            @id @default(uuid())
  auteur_id        String
  cible_id         String
  trajet_id        String?
  motif            MotifSignalement
  description      String?           @db.Text
  statut           StatutSignalement @default(EN_ATTENTE)
  date_creation    DateTime          @default(now())
  date_mise_a_jour DateTime          @updatedAt

  auteur User    @relation("SignalementAuteur", fields: [auteur_id], references: [id], onDelete: Cascade)
  cible  User    @relation("SignalementCible", fields: [cible_id], references: [id], onDelete: Cascade)
  trajet Trajet? @relation(fields: [trajet_id], references: [id], onDelete: SetNull)

  @@index([auteur_id])
  @@index([cible_id])
  @@index([trajet_id])
  @@map("signalements")
}

model AlerteSos {
  id               String          @id @default(uuid())
  utilisateur_id   String
  trajet_id        String
  latitude         Float
  longitude        Float
  statut           StatutAlerteSos @default(ACTIVE)
  date_creation    DateTime        @default(now())
  date_mise_a_jour DateTime        @updatedAt

  utilisateur User   @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  trajet      Trajet @relation(fields: [trajet_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id])
  @@index([trajet_id])
  @@map("alertes_sos")
}
